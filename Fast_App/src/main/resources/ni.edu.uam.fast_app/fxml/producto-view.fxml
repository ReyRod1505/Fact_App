<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.image.ImageView?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="ni.edu.uam.fast_app.controller.ProductoController"
            prefWidth="850" prefHeight="550">

    <!-- PARTE SUPERIOR: Título -->
    <top>
        <HBox alignment="CENTER_LEFT" styleClass="header">
            <Label text="Gestión de Productos" styleClass="header-title"/>
        </HBox>
    </top>

    <!-- CENTRO: Formulario + Tabla -->
    <center>
        <HBox spacing="15">
            <padding>
                <Insets top="15" right="15" bottom="15" left="15"/>
            </padding>

            <!-- FORMULARIO (lado izquierdo) -->
            <VBox spacing="12" prefWidth="320">
                <Label text="Datos del Producto" styleClass="form-title"/>

                <GridPane hgap="10" vgap="10">
                    <columnConstraints>
                        <ColumnConstraints minWidth="80" prefWidth="90"/>
                        <ColumnConstraints minWidth="150" prefWidth="200"/>
                    </columnConstraints>

                    <Label text="Código:" styleClass="form-label"
                           GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <TextField fx:id="txtCodigo" promptText="Ej: P001"
                               GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                    <Label text="Nombre:" styleClass="form-label"
                           GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <TextField fx:id="txtNombre" promptText="Nombre del producto"
                               GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                    <Label text="Categoría:" styleClass="form-label"
                           GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <ComboBox fx:id="cmbCategoria" promptText="Seleccione..."
                              maxWidth="1.7976931348623157E308"
                              GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                    <Label text="Precio:" styleClass="form-label"
                           GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                    <TextField fx:id="txtPrecio" promptText="0.00"
                               GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                    <Label text="Existencia:" styleClass="form-label"
                           GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                    <TextField fx:id="txtExistencia" promptText="0"
                               GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                    <Label text="Activo:" styleClass="form-label"
                           GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                    <CheckBox fx:id="chkActivo" selected="true"
                              GridPane.rowIndex="5" GridPane.columnIndex="1"/>
                </GridPane>

                <!-- Vista previa de imagen -->
                <Label text="Imagen:" styleClass="form-label"/>
                <ImageView fx:id="imgProducto" fitWidth="180" fitHeight="120"
                           preserveRatio="true"
                           style="-fx-border-color: #ccc;"/>

                <!-- Botones del formulario -->
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Button fx:id="btnImagen" text="Seleccionar Imagen"
                            onAction="#seleccionarImagen" styleClass="btn-secondary"/>
                    <Button fx:id="btnGuardar" text="Guardar"
                            onAction="#guardar" styleClass="btn-success"/>
                    <Button fx:id="btnCerrar" text="Cerrar"
                            onAction="#cerrar" styleClass="btn-danger"/>
                </HBox>
            </VBox>

            <!-- TABLA (lado derecho) -->
            <TableView fx:id="tblProductos" HBox.hgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colCodigo" text="Código" prefWidth="80"/>
                    <TableColumn fx:id="colNombre" text="Nombre" prefWidth="130"/>
                    <TableColumn fx:id="colCategoria" text="Categoría" prefWidth="100"/>
                    <TableColumn fx:id="colPrecio" text="Precio" prefWidth="80"/>
                    <TableColumn fx:id="colExistencia" text="Existencia" prefWidth="80"/>
                    <TableColumn fx:id="colActivo" text="Activo" prefWidth="60"/>
                </columns>
            </TableView>

        </HBox>
    </center>

</BorderPane>
