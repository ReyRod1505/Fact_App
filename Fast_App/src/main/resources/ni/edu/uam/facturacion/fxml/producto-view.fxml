<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.Separator?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="ni.edu.uam.facturacion.controller.ProductoController">

    <!-- Encabezado -->
    <top>
        <HBox alignment="CENTER_LEFT" style="-fx-background-color: #334155; -fx-padding: 10 16;">
            <Label text="Gestion de Productos" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white;"/>
        </HBox>
    </top>

    <!-- Contenido principal -->
    <center>
        <HBox spacing="14">
            <padding><Insets top="12" right="14" bottom="12" left="14"/></padding>

            <!-- Formulario (Lado izquierdo) -->
            <VBox spacing="10" prefWidth="290"
                  style="-fx-background-color: white; -fx-padding: 14; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-background-radius: 6;">

                <Label text="Datos del Producto" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>

                <GridPane hgap="8" vgap="8">
                    <columnConstraints>
                        <ColumnConstraints minWidth="80" prefWidth="85"/>
                        <ColumnConstraints minWidth="150" prefWidth="175"/>
                    </columnConstraints>

                    <Label text="Codigo *" style="-fx-font-weight: bold; -fx-font-size: 12px;" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <TextField fx:id="txtCodigo" promptText="Ej: P001" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                    <Label text="Nombre *" style="-fx-font-weight: bold; -fx-font-size: 12px;" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <TextField fx:id="txtNombre" promptText="Nombre del producto" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                    <Label text="Categoria *" style="-fx-font-weight: bold; -fx-font-size: 12px;" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <ComboBox fx:id="cmbCategoria" promptText="Seleccione..." maxWidth="1.7976931348623157E308" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                    <Label text="Precio *" style="-fx-font-weight: bold; -fx-font-size: 12px;" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                    <TextField fx:id="txtPrecio" promptText="0.00" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                    <Label text="Existencia *" style="-fx-font-weight: bold; -fx-font-size: 12px;" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                    <TextField fx:id="txtExistencia" promptText="0" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                    <Label text="Activo" style="-fx-font-weight: bold; -fx-font-size: 12px;" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                    <CheckBox fx:id="chkActivo" selected="true" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
                </GridPane>

                <Separator style="-fx-padding: 4 0;"/>

                <!-- Botones CRUD -->
                <VBox spacing="6">
                    <HBox spacing="6">
                        <Button fx:id="btnGuardar" text="Guardar" onAction="#guardar" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS"
                                style="-fx-background-color: #0f766e; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 4; -fx-padding: 6 10; -fx-cursor: hand;"/>
                        <Button fx:id="btnActualizar" text="Actualizar" onAction="#actualizar" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS"
                                style="-fx-background-color: #0284c7; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 4; -fx-padding: 6 10; -fx-cursor: hand;"/>
                    </HBox>
                    <HBox spacing="6">
                        <Button fx:id="btnEliminar" text="Eliminar" onAction="#eliminar" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS"
                                style="-fx-background-color: #e11d48; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 4; -fx-padding: 6 10; -fx-cursor: hand;"/>
                        <Button fx:id="btnLimpiar" text="Limpiar" onAction="#limpiar" maxWidth="1.7976931348623157E308" HBox.hgrow="ALWAYS"
                                style="-fx-background-color: #64748b; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 4; -fx-padding: 6 10; -fx-cursor: hand;"/>
                    </HBox>
                </VBox>

            </VBox>

            <!-- Seccion derecha: Busqueda, filtros y tabla -->
            <VBox spacing="8" HBox.hgrow="ALWAYS">

                <!-- Barra de busqueda y filtros -->
                <HBox spacing="8" alignment="CENTER_LEFT"
                      style="-fx-background-color: white; -fx-padding: 8 12; -fx-border-color: #cbd5e1; -fx-border-radius: 6; -fx-background-radius: 6;">
                    
                    <Label text="Buscar:" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #475569;"/>
                    <TextField fx:id="txtBuscar" promptText="Codigo, nombre o categoria..." HBox.hgrow="ALWAYS"/>

                    <Label text="Categoria:" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #475569;"/>
                    <ComboBox fx:id="cmbFiltroCategoria" promptText="Todas las categorias" prefWidth="150"/>

                    <Label text="Estado:" style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #475569;"/>
                    <ComboBox fx:id="cmbFiltroEstado" prefWidth="105"/>

                    <Button text="Limpiar filtros" onAction="#limpiarFiltros"
                            style="-fx-background-color: #e2e8f0; -fx-text-fill: #475569; -fx-cursor: hand; -fx-background-radius: 4; -fx-padding: 5 10; -fx-font-size: 12px;"/>
                </HBox>

                <!-- Tabla de productos -->
                <TableView fx:id="tblProductos" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colCodigo" text="Codigo" prefWidth="85"/>
                        <TableColumn fx:id="colNombre" text="Nombre" prefWidth="160"/>
                        <TableColumn fx:id="colCategoria" text="Categoria" prefWidth="110"/>
                        <TableColumn fx:id="colPrecio" text="Precio" prefWidth="85"/>
                        <TableColumn fx:id="colExistencia" text="Existencia" prefWidth="85"/>
                        <TableColumn fx:id="colActivo" text="Activo" prefWidth="65"/>
                    </columns>
                    <placeholder><Label text="No se encontraron productos."/></placeholder>
                </TableView>

                <HBox alignment="CENTER_RIGHT" style="-fx-padding: 2 4;">
                    <Label fx:id="lblTotalRegistros" text="Mostrando 0 productos" style="-fx-font-size: 11px; -fx-text-fill: #64748b;"/>
                </HBox>

            </VBox>
        </HBox>
    </center>
</BorderPane>
