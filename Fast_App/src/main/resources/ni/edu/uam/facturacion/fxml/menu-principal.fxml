<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Tooltip?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="ni.edu.uam.facturacion.controller.MenuPrincipalController">

    <top>
        <VBox>
            <!-- ===== BARRA DE MENÚ ===== -->
            <MenuBar>
                <Menu text="Archivo">
                    <MenuItem text="🏠 Inicio"       onAction="#mostrarInicio"/>
                    <MenuItem fx:id="mnuProductos"  text="📦 Productos"   onAction="#abrirProductos"/>
                    <MenuItem fx:id="mnuEmpleados"  text="👤 Empleados"   onAction="#abrirEmpleados"/>
                    <MenuItem fx:id="mnuCargos"     text="🏷 Cargos"      onAction="#abrirCargos"/>
                    <MenuItem fx:id="mnuCategorias" text="📁 Categorías"  onAction="#abrirCategorias"/>
                    <SeparatorMenuItem/>
                    <MenuItem fx:id="mnuSalir"      text="⏻ Salir"       onAction="#salir"/>
                </Menu>
            </MenuBar>

            <!-- ===== BARRA DE HERRAMIENTAS (solo íconos 32×32) ===== -->
            <ToolBar style="-fx-background-color: #2c3e50; -fx-padding: 4 12;">

                <!-- Inicio -->
                <Button fx:id="btnInicio" onAction="#mostrarInicio"
                        style="-fx-background-color: transparent; -fx-cursor: hand; -fx-padding: 4; -fx-background-radius: 6;"
                        prefWidth="40" prefHeight="40">
                    <graphic><Label text="🏠" style="-fx-font-size: 22px;"/></graphic>
                    <tooltip><Tooltip text="Inicio"/></tooltip>
                </Button>

                <Separator orientation="VERTICAL" style="-fx-background-color: #4a6278;"/>

                <!-- Productos -->
                <Button fx:id="btnProductos" onAction="#abrirProductos"
                        style="-fx-background-color: transparent; -fx-cursor: hand; -fx-padding: 4; -fx-background-radius: 6;"
                        prefWidth="40" prefHeight="40">
                    <graphic><Label text="📦" style="-fx-font-size: 22px;"/></graphic>
                    <tooltip><Tooltip text="Productos"/></tooltip>
                </Button>

                <!-- Empleados -->
                <Button fx:id="btnEmpleados" onAction="#abrirEmpleados"
                        style="-fx-background-color: transparent; -fx-cursor: hand; -fx-padding: 4; -fx-background-radius: 6;"
                        prefWidth="40" prefHeight="40">
                    <graphic><Label text="👤" style="-fx-font-size: 22px;"/></graphic>
                    <tooltip><Tooltip text="Empleados"/></tooltip>
                </Button>

                <!-- Cargos -->
                <Button fx:id="btnCargos" onAction="#abrirCargos"
                        style="-fx-background-color: transparent; -fx-cursor: hand; -fx-padding: 4; -fx-background-radius: 6;"
                        prefWidth="40" prefHeight="40">
                    <graphic><Label text="🏷" style="-fx-font-size: 22px;"/></graphic>
                    <tooltip><Tooltip text="Cargos"/></tooltip>
                </Button>

                <!-- Categorías -->
                <Button fx:id="btnCategorias" onAction="#abrirCategorias"
                        style="-fx-background-color: transparent; -fx-cursor: hand; -fx-padding: 4; -fx-background-radius: 6;"
                        prefWidth="40" prefHeight="40">
                    <graphic><Label text="📁" style="-fx-font-size: 22px;"/></graphic>
                    <tooltip><Tooltip text="Categorías"/></tooltip>
                </Button>

                <Separator orientation="VERTICAL" style="-fx-background-color: #4a6278;"/>

                <!-- Salir -->
                <Button fx:id="btnSalir" onAction="#salir"
                        style="-fx-background-color: transparent; -fx-cursor: hand; -fx-padding: 4; -fx-background-radius: 6;"
                        prefWidth="40" prefHeight="40">
                    <graphic><Label text="⏻" style="-fx-font-size: 22px; -fx-text-fill: #e74c3c;"/></graphic>
                    <tooltip><Tooltip text="Salir"/></tooltip>
                </Button>

            </ToolBar>
        </VBox>
    </top>

    <!-- ===== ÁREA DE CONTENIDO (se reemplaza al navegar) ===== -->
    <center>
        <StackPane fx:id="contenido"/>
    </center>

    <!-- ===== BARRA DE ESTADO ===== -->
    <bottom>
        <Label text="  Sistema de Facturación v1.0  |  ni.edu.uam"
               style="-fx-background-color: #ecf0f1; -fx-padding: 5 14; -fx-font-size: 11px; -fx-text-fill: #95a5a6; -fx-border-color: #dce1e8; -fx-border-width: 1 0 0 0;"/>
    </bottom>

</BorderPane>
