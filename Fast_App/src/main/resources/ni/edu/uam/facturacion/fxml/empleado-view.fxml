<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="ni.edu.uam.facturacion.controller.EmpleadoController">

    <top>
        <HBox alignment="CENTER_LEFT"
              style="-fx-background-color: #27ae60; -fx-padding: 12 20;">
            <Label text="👤  Gestión de Empleados"
                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;"/>
        </HBox>
    </top>

    <center>
        <HBox spacing="14">
            <padding><Insets top="14" right="14" bottom="14" left="14"/></padding>

            <!-- FORMULARIO -->
            <VBox spacing="9" prefWidth="295"
                  style="-fx-background-color: white; -fx-padding: 14; -fx-border-color: #dce1e8; -fx-border-radius: 6; -fx-background-radius: 6;">

                <Label text="Datos del Empleado"
                       style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

                <GridPane hgap="8" vgap="8">
                    <columnConstraints>
                        <ColumnConstraints minWidth="88" prefWidth="93"/>
                        <ColumnConstraints minWidth="155" prefWidth="180"/>
                    </columnConstraints>

                    <Label text="Nombres *"      style="-fx-font-weight: bold; -fx-font-size: 12px;" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <TextField fx:id="txtNombres"   promptText="Nombres"   GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                    <Label text="Apellidos *"     style="-fx-font-weight: bold; -fx-font-size: 12px;" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <TextField fx:id="txtApellidos" promptText="Apellidos" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                    <Label text="Cargo *"         style="-fx-font-weight: bold; -fx-font-size: 12px;" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <ComboBox fx:id="cmbCargo" promptText="Seleccione..."
                              maxWidth="1.7976931348623157E308"
                              GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                    <Label text="Contratación *"  style="-fx-font-weight: bold; -fx-font-size: 12px;" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                    <DatePicker fx:id="dpFechaContratacion"
                                maxWidth="1.7976931348623157E308"
                                GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                    <Label text="Activo"          style="-fx-font-weight: bold; -fx-font-size: 12px;" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                    <CheckBox fx:id="chkActivo" selected="true"
                              GridPane.rowIndex="4" GridPane.columnIndex="1"/>
                </GridPane>

                <HBox spacing="7" style="-fx-padding: 6 0 0 0;">
                    <Button fx:id="btnGuardar" text="💾 Guardar" onAction="#guardar"
                            style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 4; -fx-padding: 7 16;"/>
                </HBox>
            </VBox>

            <!-- TABLA -->
            <TableView fx:id="tblEmpleados" HBox.hgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colNombres"   text="Nombres"      prefWidth="140"/>
                    <TableColumn fx:id="colApellidos" text="Apellidos"    prefWidth="140"/>
                    <TableColumn fx:id="colCargo"     text="Cargo"        prefWidth="120"/>
                    <TableColumn fx:id="colFecha"     text="Contratación" prefWidth="120"/>
                    <TableColumn fx:id="colActivo"    text="Activo"       prefWidth="60"/>
                </columns>
                <placeholder><Label text="No hay empleados registrados."/></placeholder>
            </TableView>
        </HBox>
    </center>

</BorderPane>
